{
  "name": "@accountant-ai-operator/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Accountant AI Operator - Desktop Companion. חלון שולחן-עבודה שטוען את האתר (Vercel) ומוסיף שתי יכולות מקומיות: בחירת קובץ הפעלה בלחיצה, והפעלת תוכנה מותקנת.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^20.19.23",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "il.accountantaioperator.desktop",
    "productName": "Accountant AI Operator",
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "jakobaror-wq",
      "repo": "accountant-ai-operator"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "shortcutName": "Accountant AI Operator"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Office"
    }
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron-updater": "^6.3.9"
  }
}
